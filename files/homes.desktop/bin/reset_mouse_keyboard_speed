#!/bin/bash
# -*- Mode: shell-script -*-
#template by ~tconnors/bin/newshscript
#Fri Jul 13 22:02:40 EST 2012
# $Revision: 1.10 $ $Date: 2025/10/27 04:48:00 $
# $Id: reset_mouse_keyboard_speed,v 1.10 2025/10/27 04:48:00 tconnors Exp $
# $Header: /home/tconnors/cvsroot/bin/reset_mouse_keyboard_speed,v 1.10 2025/10/27 04:48:00 tconnors Exp $
# $RCSfile: reset_mouse_keyboard_speed,v $

keyboard=true
mouse=true

detect_external_mice() {
    mice=$( xinput list | grep pointer | grep -v -E '(Virtual core pointer|XTEST pointer|Touchscreen|DELL087F:00 04F3:3082)' )
    echo "mice=$mice"
    number_mice=$( echo "$mice" | grep . | wc -l )
    echo number_mice=$number_mice

    if [ $number_mice = 0 ] ; then
        return 1
    fi
}

no_mice_to_configure() {
    gxmessage -timeout 2 -geometry +500+500 'reset_mouse_keyboard_speed: No mice to be configured?' &
    success=true  #nothing to fail, I guess...
}

configure_mouse_settings() {
    case $SHORTHOST in
        dirac|gamow|fermi|dirac-laptop)
            if ! detect_external_mice ; then
                no_mice_to_configure
                return
            fi

            xset m 20/10 30   # twice the speed, when moving more than 30 pixels (so already moving quite rapidly)
            # xinput list: ->
            for dev in 'HID 046d:c521' 'Logitech MX Master 3' 'Logitech MX Master 3 Mouse' 'Logitech MX Master 3S' 'Logitech Wireless Device PID:4082 Mouse' ; do
                if ! list_props=$( hiliteStdErr --no-colour-stdout xinput list-props "pointer:$dev" ) ; then
                    if ! $shown_list ; then
                        hiliteStdErr xinput list
                        shown_list=true
                    fi
                    continue
                fi
                echo "Found $dev"
                echo
                # xinput list | grep pointer | grep -v -E '(Virtual core pointer|XTEST pointer|Touchscreen|DELL087F:00 04F3:3082)'
                case "$dev" in
                    # new MX master 3S (also keeps changing!)
                    MX\ Master\ 3S\ Mouse)
                        adj=(
                            ["libinput Accel Speed"]="0.01"
                        )
                        ;;
                    MX\ Master\ 3S)
                        adj=(
                            ["libinput Accel Speed"]="0.01"
                        )
                        ;;
                    # old MX master 3
                    Logitech\ MX\ Master\ 3|Logitech\ MX\ Master\ 3\ Mouse) # Do I need to detect both "Master 3 Mouse" and "Master 3"?  Perhaps there's a bluetooth vs universal reciever difference?
                        adj=(
                            ["libinput Accel Speed"]="0.7"
                        )
                        ;;
                    Logitech\ Wireless\ Device\ PID:4082\ Mouse) # Same mx Master 3!  No idea why this keeps changing!
                        adj=(
                            ["libinput Accel Speed"]="0.5"
                        )
                        ;;
                    HID*)
                        adj=(
                            ["libinput Accel Speed"]="0.9"
                        )
                        ;;
                    *)
                        echo "Forgot dev match? $dev"
                        break
                        ;;
                esac
                for k in "${!adj[@]}" ; do
                    if echo "$list_props" | grep "$k" ; then
                        v="${adj[$k]}"
                        xinput set-prop "pointer:$dev" "$k" "$v" && success=true
                        echo " Setting pointer:$dev $k $v"
                        echo -n "    --> "
                        xinput list-props "pointer:$dev" | grep "$k"
                    fi
                done
            done
            ;;
        scuzzie|dirac-laptop|maxwell)
            xset m 13/10 1
            no_mice_to_configure
            ;;
        *)
            xset m 8/3
            no_mice_to_configure
            ;;
    esac
}

case "$1" in
    --keyboard)
        mouse=false
        ;;
    --mouse)
        keyboard=false
        ;;
esac

if $keyboard ; then
    xset r on
    xset r rate 400 40
fi

if ! $mouse ; then
    exit
fi

shown_list=false
success=false
declare -A adj=()
list_props=
case $LONGHOST-$SHORTDISPHOST in
    bohr*-galileo)
        xset m 8/3
        ;;
    scuzzie*-*|dirac*-*|gamow*-*|maxwell*-*|bohr*-*|hubble*-*|penrose*-*|curie*-*|fermi*-*)
        configure_mouse_settings
        ;;
    *.ltu.edu.au-*)
        #xset m 4/3 10
        :
        ;;
    *.swin.edu.au-*)
        case $LONGHOST in
            oxygen*.swin.edu.au|polonium*.swin.edu.au)
                xset m 10/3 2000
                ;;
            *)
                xset m 4/3
                ;;
        esac
        ;;
    *)
        xset m 11/3 8
        ;;
esac

! $success && gxmessage -timeout 5 -geometry +500+500 'reset_mouse_keyboard_speed: Keyboard or mouse failed to set customisations; see reset_mouse_keyboard_speed' &

$success
