#!/bin/bash
# -*- Mode: shell-script -*-
#template by ~tconnors/bin/newshscript
#Fri Jul 13 22:02:40 EST 2012
# $Revision: 1.10 $ $Date: 2025/10/27 04:48:00 $
# $Id: reset_mouse_keyboard_speed,v 1.10 2025/10/27 04:48:00 tconnors Exp $
# $Header: /home/tconnors/cvsroot/bin/reset_mouse_keyboard_speed,v 1.10 2025/10/27 04:48:00 tconnors Exp $
# $RCSfile: reset_mouse_keyboard_speed,v $

allowed_hids='(Virtual core pointer|XTEST pointer|Touchscreen|DELL087F:00 04F3:3082)'
# xinput list: ->
read -r -d '' params <<EOF
# old MX master 3
# Do I need to detect both "Master 3 Mouse" and "Master 3"?  Perhaps
# there's a bluetooth vs universal reciever difference?
"Logitech MX Master 3|Logitech MX Master 3 Mouse"   "libinput Accel Speed" "0.7"

# Same device as mx Master 3!  No idea why this keeps changing!
"Logitech Wireless Device PID:4082 Mouse"           "libinput Accel Speed" "0.5"

# new MX master 3S (also keeps changing!)
"MX Master 3S Mouse"                                "libinput Accel Speed" "0.01"
"MX Master 3S"                                      "libinput Accel Speed" "0.01"

"HID*"                                              "libinput Accel Speed" "0.9"
EOF

keyboard=true
mouse=true

detect_external_mice() {
    mice=$( xinput list | grep pointer | grep -v -E "$allowed_hids" )
    # echo "mice=$mice"
    number_mice=$( echo "$mice" | grep . | wc -l )
    # echo number_mice=$number_mice

    if [ $number_mice = 0 ] ; then
        return 1
    fi
}

no_mice_to_configure() {
    gxmessage -timeout 2 -geometry +500+500 'reset_mouse_keyboard_speed: No mice to be configured?' 2>/dev/null &
    success=true  #nothing to fail, I guess...
}

configure_mouse_settings() {
    case $SHORTHOST in
        dirac|gamow|fermi|dirac-laptop)
            if ! detect_external_mice ; then
                no_mice_to_configure
                return
            fi

            xset m 20/10 30   # twice the speed, when moving more than 30 pixels (so already moving quite rapidly)

            while read device ; do
                found_device=false
                while read param_map ; do
                    case "$param_map" in
                        # comments or blank lines
                        \#*|"")
                            # echo "comment or blank line found: $param_map"
                            continue
                            ;;
                        *)
                            devmatch=$( echo "$param_map" | sed -n 's/^"\(.*\)" \+"\(.*\)" \+"\(.*\)"$/\1/p' )
                            key=$( echo "$param_map" | sed -n 's/^"\(.*\)" \+"\(.*\)" \+"\(.*\)"$/\2/p' )
                            val=$( echo "$param_map" | sed -n 's/^"\(.*\)" \+"\(.*\)" \+"\(.*\)"$/\3/p' )
                            devmatch="@($devmatch)"
                            if [ -z "$val" ] ; then
                                echo "parse error: $param_map"
                                continue
                            fi
                            # echo "devmatch:$devmatch found"
                            ;;
                    esac
                    shopt -s extglob
                    # echo "Comparing: $device <= $devmatch?"

                    case "$device" in
                        $devmatch)
                            if ! list_props=$(
                                    hiliteStdErr --no-colour-stdout xinput list-props "pointer:$device"
                                 ) ; then
                                if ! $shown_list ; then
                                    hiliteStdErr echo "$mice"
                                    shown_list=true
                                fi
                                continue
                            fi
                            echo "Found $device <= $devmatch, want to set: $key = $val"
                            echo
                            found_device=true
                            if echo "$list_props" | grep "$key" ; then
                                xinput set-prop "pointer:$device" "$key" "$val" &&
                                    success=true
                                echo " Setting pointer:$device $key $val"
                                echo -n "    --> "
                                xinput list-props "pointer:$device" | grep "$key"
                            fi
                            ;;
                    esac
                done <<< "$params"
                if ! $found_device ; then
                    echo "No match for device: $device"
                fi
            done < <( echo "$mice" |
                          # just get the device portion of these style strings:
                          # ⎜   ↳ MX Master 3S Mouse                        id=7    [slave  pointer  (2)]
                          sed -E 's/^[^0-9A-Za-z]+\s([^[:space:]].*[^[:space:]])\s+id=.*/\1/' )

            ;;
        scuzzie|maxwell)
            xset m 13/10 1
            no_mice_to_configure
            ;;
        *)
            xset m 8/3
            no_mice_to_configure
            ;;
    esac
}

case "$1" in
    --keyboard)
        mouse=false
        ;;
    --mouse)
        keyboard=false
        ;;
esac

if $keyboard ; then
    xset r on
    xset r rate 400 40
fi

if ! $mouse ; then
    exit
fi

shown_list=false
success=false
list_props=
case $LONGHOST-$SHORTDISPHOST in
    bohr*-galileo)
        xset m 8/3
        ;;
    scuzzie*-*|dirac*-*|gamow*-*|maxwell*-*|bohr*-*|hubble*-*|penrose*-*|curie*-*|fermi*-*)
        configure_mouse_settings
        ;;
    *.ltu.edu.au-*)
        #xset m 4/3 10
        :
        ;;
    *.swin.edu.au-*)
        case $LONGHOST in
            oxygen*.swin.edu.au|polonium*.swin.edu.au)
                xset m 10/3 2000
                ;;
            *)
                xset m 4/3
                ;;
        esac
        ;;
    *)
        xset m 11/3 8
        ;;
esac

! $success && gxmessage -timeout 5 -geometry +500+500 'reset_mouse_keyboard_speed: Keyboard or mouse failed to set customisations; see reset_mouse_keyboard_speed' 2>/dev/null &

$success
